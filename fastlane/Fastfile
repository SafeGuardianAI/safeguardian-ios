default_platform :ios

platform :ios do

  # Connect to App Store Connect via API key stored in CI secrets.
  # Required env vars: ASC_API_KEY_ID, ASC_API_ISSUER_ID, ASC_API_KEY_CONTENT (base64 .p8).
  before_all do
    if ENV["ASC_API_KEY_CONTENT"]
      app_store_connect_api_key(
        key_id: ENV["ASC_API_KEY_ID"],
        issuer_id: ENV["ASC_API_ISSUER_ID"],
        key_content: Base64.decode64(ENV["ASC_API_KEY_CONTENT"]),
        is_key_content_base64: false,
        in_house: false,
      )
    end
  end

  desc "Run unit tests"
  lane :test do
    run_tests(
      project: "SafeGuardian.xcodeproj",
      scheme: "SafeGuardian (iOS)",
      destination: "platform=iOS Simulator,name=iPhone 16,OS=latest",
      configuration: "Debug",
      code_coverage: false,
    )
  end

  desc "Build and upload a new beta to TestFlight"
  lane :beta do
    # Increment build number from latest TestFlight build + 1.
    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: "SafeGuardian.xcodeproj",
    )

    build_app(
      project: "SafeGuardian.xcodeproj",
      scheme: "SafeGuardian (iOS)",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        teamID: "V9KH637N7P",
        signingStyle: "automatic",
        uploadBitcode: false,
        uploadSymbols: true,
      },
      xcargs: "-jobs 4 COMPILER_INDEX_STORE_ENABLE=NO",
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Submit current TestFlight build to App Store review"
  lane :release do
    deliver(
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: false,
    )
  end

end
